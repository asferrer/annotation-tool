# === Required ===
# Hugging Face token with access to the gated model facebook/sam3
HF_TOKEN=your_huggingface_token_here

# === Optional - SAM 3 (segmentation service) ===
SAM3_MODEL_ID=facebook/sam3
SAM3_LAZY_LOAD=true
SAM3_FP32=false
LABELING_COOLDOWN_MS=200
INTER_CLASS_COOLDOWN_MS=300
VIDEO_MAX_FRAMES=3000

# === Optional - INSID3 (one-shot propagation) ===
# DINOv3 weights must be downloaded manually (gated by Meta) into this directory
DINOV3_WEIGHTS_DIR=/app/checkpoints/dinov3
INSID3_MODEL_SIZE=large

# === Optional - Gateway (read by docker-compose.override.yml) ===
SEGMENTATION_SERVICE_URL=http://segmentation:8002
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
ALLOWED_FS_PATHS=/app/datasets
